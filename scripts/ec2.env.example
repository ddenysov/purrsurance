# Amazon Linux EC2 — optional overrides for ec2-startup.sh (re-runs)
# First boot: edit variables directly in scripts/ec2-user-data.sh

PURRSURANCE_APP_DIR=/opt/purrsurance
PURRSURANCE_BACKEND_DIR=/opt/purrsurance/apps/backend
PURRSURANCE_SKIP_GIT=1

# PURRSURANCE_REPO_URL=https://github.com/your-org/purrsurance.git
# PURRSURANCE_REPO_BRANCH=main
# PURRSURANCE_ENV_SSM_PARAM=/purrsurance/backend/.env
