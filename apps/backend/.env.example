APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=80
# Public HTTPS base URL for webhooks / external callbacks (Telegram uses this; falls back to APP_URL if empty).
# Example: make ngrok-sync-env, or set to your production origin without a trailing slash.
PUBLIC_APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret
POSTGRES_PORT=5432
PGWEB_PORT=3030

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

NEURON_BASE_URL=https://api.neuron-ai.dev/v1
NEURON_API_KEY=
NEURON_MODEL=gpt-4o-mini
NEURON_TEMPERATURE=0.85
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TEMPERATURE=0.85

VITE_APP_NAME="${APP_NAME}"
VITE_PORT=5173

# mcp-atlassian (php mcp/client_jira.php) — mirror Cursor mcpServers.mcp-atlassian.env
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
# Optional Confluence (same MCP server)
CONFLUENCE_URL=
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=
# Jira Server/Data Center: use JIRA_PERSONAL_TOKEN instead of username + API token
# JIRA_PERSONAL_TOKEN=
